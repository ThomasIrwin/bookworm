          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note-draft" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;This page is a starting point, not a design.&lt;/b&gt;&#xa;&#xa;Solid boxes are what V1__create_initial_schema.sql&#xa;actually creates today. Dashed boxes are my reading of&#xa;your user stories — they are deliberately incomplete.&#xa;&#xa;Every ⚠ is a decision that belongs to you. Work through&#xa;them before writing V2, because migrations are cheap&#xa;to write and expensive to undo once data exists." vertex="1">
