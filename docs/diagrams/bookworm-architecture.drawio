        <mxCell id="cross" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;Cross-cutting&lt;/b&gt;&#xa;&#xa;• GlobalExceptionHandler&#xa;   @ControllerAdvice — maps domain&#xa;   exceptions to HTTP status codes&#xa;&#xa;• SecurityConfig — JWT resource server&#xa;• WebConfig — CORS (⚠ lock down for prod)&#xa;• Flyway — versioned migrations&#xa;• Actuator — /actuator/health&#xa;• DTOs (records) at the controller edge&#xa;   so entities never cross the wire" vertex="1">
          <mxGeometry height="360" width="230" x="40" y="240" as="geometry" />
        </mxCell>
        <mxCell id="rule" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;Architectural rule&lt;/b&gt;&#xa;&#xa;A service may call another&#xa;&lt;i&gt;service&lt;/i&gt;, never another&#xa;module&#39;s &lt;i&gt;repository&lt;/i&gt;.&#xa;&#xa;Keeps each module the sole&#xa;owner of its persistence,&#xa;so invariants live in exactly&#xa;one place." vertex="1">
          <mxGeometry height="250" width="230" x="40" y="640" as="geometry" />
        </mxCell>
