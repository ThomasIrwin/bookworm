  <diagram id="page-3-data" name="3 - Data Model (draft + open questions)">
    <mxGraphModel dx="1354" dy="937" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t-users" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;" value="&lt;b&gt;users&lt;/b&gt;  (V1 — exists)&#xa;&#xa;id            BIGSERIAL PK&#xa;auth0_id      VARCHAR(255) UNIQUE NOT NULL" vertex="1">
          <mxGeometry height="120" width="330" x="60" y="100" as="geometry" />
        </mxCell>
        <mxCell id="t-books" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;" value="&lt;b&gt;books&lt;/b&gt;  (V1 — exists)&#xa;&#xa;id            BIGSERIAL PK&#xa;title         VARCHAR(255) NOT NULL&#xa;author        VARCHAR(255) NOT NULL&#xa;description   VARCHAR(1000)&#xa;&#xa;⚠ page_count needed for progress %&#xa;⚠ isbn / external_id needed for ETL upsert&#xa;⚠ is_fiction flag? or derive from genre?&#xa;⚠ UNIQUE (title, author) — or equals()/hashCode()?" vertex="1">
          <mxGeometry height="250" width="400" x="620" y="100" as="geometry" />
        </mxCell>
        <mxCell id="t-ub" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;" value="&lt;b&gt;user_books&lt;/b&gt;  (V1 — exists, needs extending)&#xa;&#xa;id              BIGSERIAL PK&#xa;user_id         BIGINT FK → users&#xa;book_id         BIGINT FK → books&#xa;reading_status  VARCHAR(50) NOT NULL&#xa;&#xa;⚠ current_page      INT  (story 3)&#xa;⚠ started_at        TIMESTAMPTZ&#xa;⚠ finished_at       TIMESTAMPTZ&#xa;⚠ UNIQUE (user_id, book_id)?" vertex="1">
          <mxGeometry height="250" width="400" x="60" y="330" as="geometry" />
        </mxCell>
        <mxCell id="t-session" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontColor=#333333;" value="&lt;b&gt;reading_sessions&lt;/b&gt;  (planned — story 4)&#xa;&#xa;id              BIGSERIAL PK&#xa;user_book_id    BIGINT FK → user_books&#xa;started_at      TIMESTAMPTZ NOT NULL&#xa;ended_at        TIMESTAMPTZ&#xa;start_page      INT&#xa;end_page        INT&#xa;&#xa;⚠ store duration, or always derive it?&#xa;⚠ how do you handle an abandoned session&#xa;   (started, never stopped)?" vertex="1">
          <mxGeometry height="270" width="400" x="60" y="640" as="geometry" />
        </mxCell>
        <mxCell id="t-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontColor=#333333;" value="&lt;b&gt;notes&lt;/b&gt;  (planned — stories 6 &amp; 7)&#xa;&#xa;id              BIGSERIAL PK&#xa;user_book_id    BIGINT FK → user_books&#xa;session_id      BIGINT FK → reading_sessions (nullable?)&#xa;body            TEXT NOT NULL&#xa;page            INT&#xa;is_public       BOOLEAN NOT NULL DEFAULT false&#xa;created_at      TIMESTAMPTZ&#xa;&#xa;⚠ attach to user_book, or to session, or both?&#xa;⚠ separate &quot;quote&quot; type vs free note?" vertex="1">
          <mxGeometry height="270" width="440" x="560" y="640" as="geometry" />
        </mxCell>
        <mxCell id="t-genres" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontColor=#333333;" value="&lt;b&gt;genres&lt;/b&gt; + &lt;b&gt;book_genres&lt;/b&gt;  (planned)&#xa;&#xa;genres(id, name, is_fiction)&#xa;book_genres(book_id, genre_id)  ← many-to-many&#xa;&#xa;⚠ a book with 2 genres matches 2 question sets.&#xa;   Which wins? Options: primary_genre column,&#xa;   priority/weight on genres, union then sample N,&#xa;   or scope questions to fiction/non-fiction only." vertex="1">
          <mxGeometry height="230" width="440" x="1100" y="100" as="geometry" />
        </mxCell>
        <mxCell id="t-questions" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontColor=#333333;" value="&lt;b&gt;questions&lt;/b&gt;  (planned — story 5)&#xa;&#xa;id              BIGSERIAL PK&#xa;text            TEXT NOT NULL&#xa;scope           VARCHAR  (GLOBAL | FICTION | NONFICTION | GENRE)&#xa;genre_id        BIGINT FK → genres (nullable)&#xa;&#xa;⚠ system-authored only for now;&#xa;   community submission + voting is a later phase&#xa;   — leave columns out until you need them." vertex="1">
          <mxGeometry height="240" width="440" x="1100" y="380" as="geometry" />
        </mxCell>
        <mxCell id="t-responses" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontColor=#333333;" value="&lt;b&gt;question_responses&lt;/b&gt;  (planned — story 5)&#xa;&#xa;id              BIGSERIAL PK&#xa;question_id     BIGINT FK → questions&#xa;session_id      BIGINT FK → reading_sessions&#xa;body            TEXT&#xa;created_at      TIMESTAMPTZ&#xa;&#xa;⚠ open question you flagged earlier: one response&#xa;   table with nullable FKs, or separate tables per&#xa;   context? Nullable FKs are simpler but let the DB&#xa;   accept rows that make no sense — a CHECK&#xa;   constraint can close that gap." vertex="1">
          <mxGeometry height="270" width="440" x="1100" y="670" as="geometry" />
        </mxCell>
