        <mxCell id="tables" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="users  |  books  |  user_books  |  reading_sessions (planned)  |  notes (planned)  |  questions + responses (planned)  |  genres (planned)" vertex="1">
          <mxGeometry height="42" width="1280" x="330" y="862" as="geometry" />
